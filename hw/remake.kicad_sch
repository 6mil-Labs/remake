	(text "PH 2.0: populate ONE connector;\nverify pack polarity before insertion.\n\nPopulate ONE power switch and ONE reset\nswitch, on the module face.\n\nPWR common = BAT+;\nON throw = BAT_SW.\n\nUSB must be unplugged for maintenance."
		(exclude_from_sim no)
		(at 149.86 86.36 0)
		(effects
			(font
				(size 2.032 2.032)
			)
		)
		(uuid "760c71ce-928a-5e3f-850b-7eb3f93f03d0")
	)
	(text "MCU SOCKET\n\ncontacts isolated until the selected jumper bank is bridged"
		(exclude_from_sim no)
		(at 302.26 233.68 0)
		(effects
			(font
				(size 2.032 2.032)
			)
		)
		(uuid "90c8deb1-1709-57ac-8d2e-afbcf87c3cc2")
	)
	(text "Matrix: COL to switch to diode anode; cathode to ROW. One diode per key.\nLEFT: MCU/display on F; bridge L bank on B. RIGHT: modules on B; bridge R bank on F.\nNEVER bridge both banks. MCU component side faces the PCB. USB at the upper end."
		(exclude_from_sim no)
		(at 219.71 37.846 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left)
		)
		(uuid "b4dbdf2b-17a7-5e24-9cf4-5fe749f4e396")
	)
